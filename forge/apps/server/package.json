{
  "name": "@4ge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "4GE API server: Node HTTP + SSE on 127.0.0.1:17400. Hosts the orchestra, builds, mods and sandbox control, and serves the built studio.",
  "exports": {
    ".": {
      "@4ge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@4ge/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@4ge/atlas": "workspace:*",
    "@4ge/bamf": "workspace:*",
    "@4ge/contracts": "workspace:*",
    "@4ge/gate": "workspace:*",
    "@4ge/kit": "workspace:*",
    "@4ge/mods": "workspace:*",
    "@4ge/orchestra": "workspace:*",
    "@4ge/orchestra-sandbox": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  }
}
