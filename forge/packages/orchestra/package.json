{
  "name": "@4ge/orchestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "4GE orchestra: Prometheus, Smith and the stage agents, the model client, the nested session tree, Seeds, builds, sprints, checkpoints and receipts.",
  "exports": {
    ".": {
      "@4ge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "live": "tsx --conditions=@4ge/source src/live.ts"
  },
  "dependencies": {
    "@4ge/atlas": "workspace:*",
    "@4ge/bamf": "workspace:*",
    "@4ge/contracts": "workspace:*",
    "@4ge/gate": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nanoid": "^6.0.2",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  }
}
