<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Omniwand</AssemblyName>
    <RootNamespace>Omniwand</RootNamespace>
    <Version>0.4.5</Version>
    <!-- The product is Holodex. AssemblyName stays Omniwand: the Input Studio runtime task and the Logi plugin launch and watch Omniwand.exe. -->
    <Product>Holodex</Product>
    <AssemblyTitle>Holodex</AssemblyTitle>
    <Description>Holodex, your own ArkStation on this PC: ask NVIDIA Nemotron, grab from the screen, and connect your tools</Description>
    <!-- No designer: the custom Phosphor controls are composed in code, so designer serialization analyzers do not apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Aperture app icon (exe, shortcuts, taskbar). Generated by tools/gen_app_icon.py from the brand files. -->
    <ApplicationIcon>assets\omniwand.ico</ApplicationIcon>
    <!-- forge\ is 4GE's own pnpm workspace (TypeScript, node_modules with symlinks); Holodex starts its built server and
         compiles nothing from it, so the SDK's default globs never walk it. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);forge\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Same icon beside the exe: the desktop and Startup shortcuts point at dist\omniwand.ico, and windows load it multi-size. -->
  <ItemGroup>
    <None Include="assets\omniwand.ico" Link="omniwand.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Inter (600, 800) and Space Grotesk (400): the design system's UI and body faces, Google Fonts static
       instances under OFL (licenses beside them). Not in packages/tokens yet; loaded privately by PhosphorFonts. -->
  <ItemGroup>
    <None Include="assets\fonts\Inter-SemiBold.ttf;assets\fonts\Inter-ExtraBold.ttf;assets\fonts\SpaceGrotesk-Regular.ttf;assets\fonts\OFL-Inter.txt;assets\fonts\OFL-SpaceGrotesk.txt" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Official MCP C# SDK, client only (no ASP.NET hosting): Hivemind's remote MCP endpoint and its OAuth 2.1 sign-in. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <!-- SVG.NET: the one SVG path reader (SvgPaths) for the emblem geometry and the lucide icons. -->
    <PackageReference Include="Svg" Version="3.4.8" />
    <!-- WebView2 (WinForms host) for the Augment Inventory, the one inventory page served by the Ark API. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <!-- The unit tests reach the Phosphor controls (the skill tree render) and the internal AInbox types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Holodex.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="logi-mx4-plugin\**" />
    <EmbeddedResource Remove="logi-mx4-plugin\**" />
    <None Remove="logi-mx4-plugin\**" />
    <Compile Remove="dist\**" />
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
  </ItemGroup>

  <!-- Phosphor faces from the design source (@ark/tokens), bundled under OFL in assets/fonts. Loaded privately by PhosphorFonts. -->
  <ItemGroup>
    <None Include="assets\fonts\JetBrainsMono-Regular.ttf;assets\fonts\ArchivoBlack-Regular.ttf;assets\fonts\JetBrainsMono-OFL.txt;assets\fonts\OFL-ArchivoBlack.txt" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF host on every .NET 5+ target with no switch to turn it off. Holodex is
       WinForms only, and the WPF assembly pulls in a second WindowsBase that conflicts (MSB3277), so it is dropped. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
