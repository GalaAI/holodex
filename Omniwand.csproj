<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Omniwand</AssemblyName>
    <RootNamespace>Omniwand</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Omniwand v0.2 — ArkStation Phosphor Shell &amp; GrimX Flow Wand</Product>
    <!-- No designer: the custom Phosphor controls are composed in code, so designer serialization analyzers do not apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Aperture app icon (exe, shortcuts, taskbar). Generated by tools/gen_app_icon.py from the brand files. -->
    <ApplicationIcon>assets\omniwand.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Same icon beside the exe: the desktop and Startup shortcuts point at dist\omniwand.ico, and windows load it multi-size. -->
  <ItemGroup>
    <None Include="assets\omniwand.ico" Link="omniwand.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Inter (600, 800) and Space Grotesk (400): the design system's UI and body faces, Google Fonts static
       instances under OFL (licenses beside them). Not in packages/tokens yet; loaded privately by PhosphorFonts. -->
  <ItemGroup>
    <None Include="assets\fonts\Inter-SemiBold.ttf;assets\fonts\Inter-ExtraBold.ttf;assets\fonts\SpaceGrotesk-Regular.ttf;assets\fonts\OFL-Inter.txt;assets\fonts\OFL-SpaceGrotesk.txt" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="logi-mx4-plugin\**" />
    <EmbeddedResource Remove="logi-mx4-plugin\**" />
    <None Remove="logi-mx4-plugin\**" />
    <Compile Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
  </ItemGroup>

  <!-- Phosphor faces from the design source (@ark/tokens), bundled under OFL in assets/fonts. Loaded privately by PhosphorFonts. -->
  <ItemGroup>
    <None Include="assets\fonts\JetBrainsMono-Regular.ttf;assets\fonts\ArchivoBlack-Regular.ttf;assets\fonts\JetBrainsMono-OFL.txt;assets\fonts\OFL-ArchivoBlack.txt" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
